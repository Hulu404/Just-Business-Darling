# Скопируй в .env и при необходимости поправь. .env в git НЕ коммитится.

environment=local
log_level=INFO

# --- PostgreSQL ---
# Локально: база, которую ты создала в установщике PostgreSQL.
# В проде: строка подключения к хосту в РФ (обязательно по требованиям к ПДн).
database_url=postgresql+psycopg://rescan:rescan@127.0.0.1:5432/rescan_core

# --- B2: подпись вебхуков МИС ---
# ОБЯЗАТЕЛЬНО заменить в проде на значение из секрет-хранилища.
mis_hmac_secret=dev-only-change-me
mis_signature_ttl_seconds=300
# ID существующей клиники. Обязателен вне local/test и при нескольких клиниках.
# mis_clinic_id=<uuid>

# --- B3: деление на группы ---
pilot_salt=dev-pilot-salt
control_percent=25

# --- B5: Уведомления (Telegram и SMS) ---

# 1. Telegram (основной канал в MVP)
# TELEGRAM_BOT_TOKEN:

telegram_bot_token=dev-telegram-token
telegram_api_url=http://127.0.0.1:8081/bot
telegram_enabled=true

# 2. SMS (запасной канал)

sms_api_url=http://127.0.0.1:8082/send
sms_fallback_enabled=falseы

# --- B11: защита контактов ---
# В проде ключ берётся из секрет-хранилища и НЕ хранится в репозитории.
contact_encryption_key=dev-encryption-key-change-me
contact_hash_salt=dev-hash-salt

# --- Роли ---
# Токен -> кто он. Для ручных вызовов админских ручек в разработке.
# В проде роли выдаёт шлюз, а не этот список.
# Пока служебные токены не нужны, в проде задайте staff_tokens={}.
staff_tokens={"dev-admin-token": {"role": "administrator", "actor_id": "dev-admin"}}

# --- CORS (для фронтенда) ---
cors_origins=["http://localhost:3000","http://127.0.0.1:3000"]
